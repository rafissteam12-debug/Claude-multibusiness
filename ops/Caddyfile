# Reverse proxy with automatic HTTPS (Let's Encrypt) for the app.
# The domain comes from APP_DOMAIN in the server's .env (passed in by ops/docker-compose.yml); never edit
# this tracked file on the server. If APP_DOMAIN is unset, the default [[BUSINESS_ID_PENDING_DOMAIN]] is
# not a valid address and Caddy refuses to start. CI validates this file with APP_DOMAIN=app.example.invalid.
# The app domain is DNS-only in Cloudflare (grey cloud): clients connect to Caddy directly, so no
# trusted_proxies setting is needed and remote_ip is the real client (see ops/RUNBOOK.md).
# No ACME account e-mail is configured (Let's Encrypt does not require one).
{
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write 120s
			idle 2m
		}
	}
}

{$APP_DOMAIN:[[BUSINESS_ID_PENDING_DOMAIN]]} {
	encode zstd gzip

	# Uploads: 10 MB per file (enforced exactly by the app); 11 MiB leaves room for multipart overhead.
	request_body {
		max_size 11MiB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The app is a tool, not a landing page: never indexed, in staging or prod.
		X-Robots-Tag "noindex, nofollow"
		# Only set if the app did not send its own CSP.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
		-X-Powered-By
	}

	reverse_proxy app:8000 {
		transport http {
			response_header_timeout 180s
		}
	}

	# Access log without personal data or secrets: IPs masked, tokens removed from query strings,
	# Referer deleted (it can carry the full token URL of the page that loaded an asset, review M2),
	# cookies/authorization never logged. Bodies (invoice data) are never logged by Caddy.
	# Owner decision: access logs are kept 14 days. Written to a rolling file on the caddy_logs volume.
	# Caddy's own rolling is size-based (backstop: rolled files deleted after 336 h). The strict age limit is
	# enforced by the `logretention` service (ops/scripts/log_retention.py): daily copy-truncate of this file
	# into access-day-YYYY-MM-DD.log and deletion of every line older than 14 days. See ops/RUNBOOK.md.
	log {
		output file /var/log/caddy/access.log {
			roll_size 5MiB
			roll_keep 60
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>uri query {
					delete token
				}
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				request>headers>X-Forwarded-For delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
