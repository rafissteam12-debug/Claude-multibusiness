{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ablaufwerk.invalid/contracts/invoice.schema.json",
  "title": "Belegbruecke invoice model v1",
  "description": "The only data model passed between mapping, engine and app. Amounts are decimal strings or numbers in EUR; dates ISO YYYY-MM-DD. Totals are NOT part of the input: the engine computes them. Field comments name the EN 16931 business term (BT). Validate with jsonschema FormatChecker enabled (dates are checked only then). Money is always a decimal string.",
  "type": "object",
  "required": [
    "number",
    "issue_date",
    "seller",
    "buyer",
    "lines",
    "payment"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "description": "BT-1 invoice number"
    },
    "type_code": {
      "type": "string",
      "enum": [
        "380",
        "381"
      ],
      "default": "380",
      "description": "BT-3: 380 invoice, 381 credit note. For 381 all amounts are positive (mapping flips negative source rows)."
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "BT-2"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "BT-72; or use period"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "BG-14"
    },
    "currency": {
      "type": "string",
      "const": "EUR",
      "default": "EUR",
      "description": "BT-5; v1 supports EUR only"
    },
    "buyer_reference": {
      "type": "string",
      "minLength": 1,
      "description": "BT-10. Optional in the model; REQUIRED by the engine for the XRechnung profile (BR-DE-15), not for ZUGFeRD EN16931."
    },
    "order_reference": {
      "type": "string",
      "description": "BT-13"
    },
    "note": {
      "type": "string",
      "description": "BT-22"
    },
    "seller": {
      "$ref": "#/$defs/party_seller"
    },
    "buyer": {
      "$ref": "#/$defs/party"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "payment": {
      "$ref": "#/$defs/payment"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "description": "Provenance for the app; never rendered into the e-invoice",
      "properties": {
        "file": {
          "type": "string"
        },
        "row_numbers": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "mapping_id": {
          "type": "string"
        },
        "expected_totals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "net": {
              "$ref": "#/$defs/money"
            },
            "vat": {
              "$ref": "#/$defs/money"
            },
            "gross": {
              "$ref": "#/$defs/money"
            }
          },
          "description": "Totals as booked in the source system; engine warns on any difference"
        }
      }
    },
    "preceding_invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "string"
        },
        "issue_date": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "BG-3, expected for credit notes"
    },
    "vat_exemptions": {
      "type": "object",
      "description": "BT-120/BT-121 per VAT category. Required for each of E, AE, K, G, O used in lines (BR-E-10, BR-AE-10, BR-IC-10, BR-G-10, BR-O-10). Never for S or Z (BR-Z-10).",
      "propertyNames": {
        "enum": [
          "E",
          "AE",
          "K",
          "G",
          "O"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^VATEX-"
          }
        },
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "code"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
      "description": "Non-negative decimal as a STRING with a dot (no floats). Credit notes use type 381 with positive amounts."
    },
    "address": {
      "type": "object",
      "required": [
        "street",
        "postcode",
        "city",
        "country"
      ],
      "properties": {
        "street": {
          "type": "string",
          "description": "BT-35 / BT-50"
        },
        "postcode": {
          "type": "string",
          "description": "BT-38 / BT-53"
        },
        "city": {
          "type": "string",
          "description": "BT-37 / BT-52"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "default": "DE",
          "description": "BT-40 / BT-55 ISO 3166-1 alpha-2"
        }
      }
    },
    "party": {
      "type": "object",
      "required": [
        "name",
        "street",
        "postcode",
        "city",
        "country",
        "electronic_address",
        "electronic_address_scheme"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "BT-27 / BT-44"
        },
        "street": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "vat_id": {
          "type": "string",
          "description": "BT-31 / BT-48"
        },
        "tax_number": {
          "type": "string",
          "description": "BT-32 seller tax number (Steuernummer), if no VAT id"
        },
        "electronic_address": {
          "type": "string",
          "description": "BT-34 / BT-49, mandatory in XRechnung"
        },
        "electronic_address_scheme": {
          "type": "string",
          "enum": [
            "EM",
            "0204",
            "9930",
            "0088"
          ],
          "description": "EAS code (BR-62/BR-63): EM e-mail, 0204 Leitweg-ID, 9930 German VAT id, 0088 GLN"
        },
        "contact": {
          "type": "object",
          "required": [
            "name",
            "phone",
            "email"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "BT-41"
            },
            "phone": {
              "type": "string",
              "description": "BT-42"
            },
            "email": {
              "type": "string",
              "description": "BT-43"
            }
          },
          "description": "BG-6, required for the seller in XRechnung"
        },
        "company_id": {
          "type": "string",
          "description": "BT-30 legal registration id (e.g. HRB), optional"
        },
        "seller_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "type": "string",
              "description": "optional ISO 6523 ICD scheme id"
            }
          },
          "description": "BT-29 seller identifier. Satisfies BR-CO-26 for sellers without VAT id or register number (e.g. small businesses)."
        }
      }
    },
    "party_seller": {
      "allOf": [
        {
          "$ref": "#/$defs/party"
        },
        {
          "required": [
            "contact"
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "vat_id"
              ]
            },
            {
              "required": [
                "company_id"
              ]
            },
            {
              "required": [
                "seller_id"
              ]
            }
          ],
          "description": "BR-CO-26: seller needs BT-31 VAT id, BT-30 legal registration id or BT-29 seller id. tax_number (BT-32) alone is NOT enough; it may be given in addition."
        }
      ]
    },
    "line": {
      "type": "object",
      "required": [
        "description",
        "quantity",
        "net_price",
        "vat_category",
        "vat_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "BT-126, defaults to position"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "BT-153 item name"
        },
        "quantity": {
          "$ref": "#/$defs/money",
          "description": "BT-129"
        },
        "unit": {
          "type": "string",
          "default": "C62",
          "description": "BT-130 UN/ECE Rec 20 code: C62 piece, HUR hour, DAY, KGM, MTR, LTR, MTK, SET"
        },
        "net_price": {
          "$ref": "#/$defs/money",
          "description": "BT-146 net unit price"
        },
        "vat_category": {
          "type": "string",
          "enum": [
            "S",
            "Z",
            "E",
            "AE",
            "K",
            "G",
            "O"
          ],
          "description": "BT-151"
        },
        "vat_rate": {
          "$ref": "#/$defs/money",
          "description": "BT-152 percent, e.g. 19, 7, 0"
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "means_code": {
          "type": "string",
          "enum": [
            "58",
            "30"
          ],
          "default": "58",
          "description": "BT-81: 58 SEPA credit transfer, 30 credit transfer. Direct debit (59) out of scope v1."
        },
        "iban": {
          "type": "string",
          "description": "BT-84"
        },
        "bic": {
          "type": "string",
          "description": "BT-86"
        },
        "account_name": {
          "type": "string",
          "description": "BT-85"
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "description": "BT-9"
        },
        "terms": {
          "type": "string",
          "description": "BT-20; Skonto in XRechnung #SKONTO# syntax"
        }
      },
      "anyOf": [
        {
          "required": [
            "due_date"
          ]
        },
        {
          "required": [
            "terms"
          ]
        }
      ],
      "if": {
        "properties": {
          "means_code": {
            "const": "58"
          }
        }
      },
      "then": {
        "required": [
          "iban"
        ]
      },
      "description": "BR-CO-25: BT-9 or BT-20 when amount due > 0; BR-DE-1, BR-DE-19"
    }
  }
}